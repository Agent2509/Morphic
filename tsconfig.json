{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@morphic/shared": ["packages/shared/src/index.ts"],
      "@morphic/shared/*": ["packages/shared/src/*"],
      "@morphic/providers": ["packages/providers/src/index.ts"],
      "@morphic/providers/*": ["packages/providers/src/*"],
      "@morphic/tools": ["packages/tools/src/index.ts"],
      "@morphic/tools/*": ["packages/tools/src/*"],
      "@morphic/core": ["packages/core/src/index.ts"],
      "@morphic/core/*": ["packages/core/src/*"],
      "@morphic/ui": ["packages/ui/src/index.ts"],
      "@morphic/ui/*": ["packages/ui/src/*"],
      "@morphic/calibration": ["packages/calibration/src/index.ts"],
      "@morphic/calibration/*": ["packages/calibration/src/*"],
      "@morphic/agents": ["packages/agents/src/index.ts"],
      "@morphic/agents/*": ["packages/agents/src/*"],
      "@morphic/memory": ["packages/memory/src/index.ts"],
      "@morphic/memory/*": ["packages/memory/src/*"],
      "@morphic/safety": ["packages/safety/src/index.ts"],
      "@morphic/safety/*": ["packages/safety/src/*"],
      "@morphic/mcp": ["packages/mcp/src/index.ts"],
      "@morphic/mcp/*": ["packages/mcp/src/*"],
      "@morphic/acp": ["packages/acp/src/index.ts"],
      "@morphic/acp/*": ["packages/acp/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "bin/**/*"
  ]
}
